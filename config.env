CONFIG_ENV=config.env

# 使用最新的社区通用内核源码作为基础
KERNEL_SOURCE=https://github.com/sm4450-development/kernel_xiaomi_sky
KERNEL_SOURCE_BRANCH=android12-5.10-sky

# 配置文件名（访问仓库确认，通常存在 vendor/ 目录下[citation:4]）
KERNEL_CONFIG=vendor/sky-perf_defconfig
KERNEL_IMAGE_NAME=Image.gz
ARCH=arm64

# 标准工具链（适配 5.10/6.1）
CLANG_BRANCH=main-kernel-2025
CLANG_VERSION=r547379
USE_LLVM=true

# 关闭相关编译选项
DISABLE_CC_WERROR=true
DISABLE_LTO=true
ADD_OVERLAYFS_CONFIG=true

KSU_VARIANT=none
ENABLE_SUSFS=false

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true

# ========== 核心源码（已修正） ==========
CONFIG_ENV=config.env
KERNEL_SOURCE=https://github.com/Caiqhsea/Xiaomi_Kernel_OpenSource
KERNEL_SOURCE_BRANCH=sky-t-oss

# ⚠️ 关键修正：必须用 GKI 配置，否则不开机
KERNEL_CONFIG=vendor/sky_GKI_defconfig
KERNEL_IMAGE_NAME=Image.gz
ARCH=arm64

# ========== Clang 工具链（5.10 专用） ==========
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_CUSTOM_CLANG=false
USE_LLVM=true

# GCC（关闭，只用 LLVM）
ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=false
USE_CUSTOM_GCC_64=false
USE_CUSTOM_GCC_32=false

# ========== Root 方案（纯内核，不集成 KSU） ==========
KSU_VARIANT=none
ENABLE_SUSFS=false

# ========== 编译防报错 ==========
DISABLE_CC_WERROR=true
ADD_KPROBES_CONFIG=true
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
EXTRA_DEFCONFIG=CONFIG_PM_DEVFREQ=y CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y

# ========== ⚠️ 打包设置（必须改这里） ==========
# 你是 GKI 设备，内核在 vendor_boot 分区，必须开启下面两项
BUILD_VENDOR_BOOT=true   # <-- 新增这一行（模板如果没有就手动加上）
BUILD_BOOT_IMG=true      # <-- 改成 true，生成可刷写的镜像
NEED_DTBO=false          # 保持 false，避免 dtbo 冲突

# 使用 AnyKernel3 自动打包（强烈建议开启）
USE_CUSTOM_ANYKERNEL3=false  # 保持 false 用模板自带的即可

# ========== 性能加速 ==========
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto
ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# 彻底关闭警告当错误处理
DISABLE_CC_WERROR=true

ADD_KPROBES_CONFIG=true
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false

EXTRA_DEFCONFIG=CONFIG_PM_DEVFREQ=y CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y

USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=trueKSU_HOOK_MODE=none
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# 关闭 SUSFS
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto
ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# 核心防报错配置
DISABLE_CC_WERROR=true
ADD_KPROBES_CONFIG=true
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false

# 解决 devfreq 报错所需配置
EXTRA_DEFCONFIG=CONFIG_PM_DEVFREQ=y CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y

# 打包与性能参数
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true

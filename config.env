CONFIG_ENV=config.env

# 保持指向你 Fork 的 Sky 官方源码 (包含缺失的 mihw 驱动)
KERNEL_SOURCE=https://github.com/Caiqhsea/Xiaomi_Kernel_OpenSource
KERNEL_SOURCE_BRANCH=sky-t-oss
KERNEL_CONFIG=vendor/sky_consolidate_defconfig
KERNEL_IMAGE_NAME=Image.gz
ARCH=arm64

KERNEL_NAME=
ADD_LOCALVERSION_TO_FILENAME=false

# 特定版本推荐：使用 Android 13 配套的工具链 (兼容高版本)
# 或者保持 r450784e 以确保非 GKI 驱动稳定性，但需要你在 Action 里继续打补丁
CLANG_BRANCH=main-kernel-2025
CLANG_VERSION=r547379

USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=
USE_LLVM=true

# 其余配置保持不变，与你之前能跑通到最后的版本一致
ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=false
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

KSU_VARIANT=none
KSU_REF=
KSU_HOOK_MODE=none
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto
ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

DISABLE_CC_WERROR=true
ADD_KPROBES_CONFIG=true
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false

EXTRA_DEFCONFIG=

USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
